# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta — nunca expor no client. Usada só em server actions/route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — Suas integrações > app > Credenciais de produção (ou teste)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Melhor Envio — Gerenciar > Tokens (cotação de frete real por CEP/peso)
MELHOR_ENVIO_TOKEN=
# CEP de origem da loja, só números (8 dígitos)
MELHOR_ENVIO_FROM_CEP=
# "true" só se o token acima for do ambiente sandbox/teste; deixe vazio em produção
MELHOR_ENVIO_SANDBOX=

# URL pública do site em produção (usada nos links de retorno de pagamento e no webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
